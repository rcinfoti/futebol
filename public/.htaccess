<IfModule mod_rewrite.c>
    RewriteEngine On
    # arquivo real (ícones, sw.js, manifest) é servido direto; o resto cai no front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# o service worker nunca pode ficar preso em cache do navegador/proxy
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache"
    </IfModule>
</Files>
