{
    "name": "rcinfoti/pelada",
    "description": "Sistema de gestão de peladas de futebol",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "RcInfoti\\Pelada\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RcInfoti\\Pelada\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
